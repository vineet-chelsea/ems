{
  "apps": [
    {
      "name": "ems-electron-dev",
      "script": "scripts/start-electron-dev.js",
      "cwd": "./",
      "instances": 1,
      "exec_mode": "fork",
      "watch": false,
      "max_memory_restart": "6G",
      "env": {
        "NODE_ENV": "development"
      },
      "error_file": "./logs/pm2-electron-dev-error.log",
      "out_file": "./logs/pm2-electron-dev-out.log",
      "log_file": "./logs/pm2-electron-dev-combined.log",
      "time": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "restart_delay": 4000,
      "kill_timeout": 5000,
      "wait_ready": false,
      "listen_timeout": 10000,
      "shutdown_with_message": false
    }
  ]
}

