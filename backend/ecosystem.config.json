{
  "apps": [
    {
      "name": "ems-backend",
      "script": "npm",
      "args": "run start",
      "cwd": "./",
      "instances": 1,
      "exec_mode": "fork",
      "max_memory_restart": "10G",
      "autorestart": true,
      "max_restarts": 10,
      "min_uptime": "10s",
      "restart_delay": 4000,
      "error_file": "./logs/pm2-error.log",
      "out_file": "./logs/pm2-out.log",
      "log_file": "./logs/pm2-combined.log",
      "time": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true
    }
  ]
}
